{
  "name": "nerando-portfolio",
  "type": "module",
  "version": "0.0.2",
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": ">=10.8.2"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "predev": "node scripts/validate-content.mjs",
    "prebuild": "node scripts/validate-content.mjs",
    "build": "astro build --remote",
    "postbuild": "npx partytown copylib dist/~partytown",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run test:run && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/netlify": "^8.2.5",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@calcom/embed-react": "^1.5.3",
    "@fingerprintjs/fingerprintjs": "^5.0.1",
    "@fontsource-variable/inter": "^5.1.1",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@iconify/json": "^2.2.527",
    "@microsoft/clarity": "^1.0.0",
    "@sendgrid/mail": "^8.1.3",
    "@supabase/supabase-js": "^2.116.0",
    "astro": "^7.3.2",
    "astro-embed": "^0.13.1",
    "astro-icon": "^1.2.0",
    "astro-microsoft-clarity-integration": "^1.0.1",
    "astro-navbar": "^2.3.9",
    "astro-seo": "^0.8.4",
    "astro-social-share": "^2.2.0",
    "autoprefixer": "^10.6.0",
    "mdast-util-to-string": "^4.0.0",
    "nodemailer": "^8.0.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reading-time": "^1.5.0",
    "sharp": "^0.33.5",
    "simple-icons-astro": "^14.3.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.18.0",
    "@iconify-json/bx": "^1.2.2",
    "@iconify-json/mdi": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.20",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.9.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "eslint": "^9.18.0",
    "eslint-plugin-astro": "^1.3.0",
    "globals": "^15.14.0",
    "happy-dom": "^20.8.3",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "vitest": "^4.0.18"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.25.5",
    "@libsql/linux-x64-gnu": "0.5.17",
    "@rollup/rollup-linux-x64-gnu": "^4.60.0"
  },
  "overrides": {
    "astro-microsoft-clarity-integration": {
      "astro": "$astro"
    },
    "astro-auto-import": {
      "astro": "$astro"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.4": true,
    "sharp@0.34.5": true,
    "sharp@0.33.5": true,
    "fsevents@2.3.3": true
  }
}
